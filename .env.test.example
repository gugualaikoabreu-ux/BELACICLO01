# Copie para .env.test e use um projeto Supabase separado, nunca produção.
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO-TESTE.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_SITE_URL="http://localhost:3003"
NEXT_PUBLIC_AUTH_CALLBACK_URL="http://localhost:3003/auth/callback"
# Opcional; mantenha somente no servidor e use uma chave secreta do projeto de teste.
SUPABASE_SECRET_KEY=""

# Copie a conexão do projeto de teste no Supabase Dashboard > Connect.
# Prefira a conexão direta ou Session pooler (porta 5432) para migrações.
DATABASE_URL_TEST="postgresql://postgres:SENHA_DO_TESTE@db.seu-projeto-ref.supabase.co:5432/postgres?sslmode=require"
DIRECT_DATABASE_URL_TEST=""
BELACICLO_TEST_DB_MODE="true"
BELACICLO_TEST_DB_CONFIRM="I_UNDERSTAND_THIS_IS_A_TEST_PROJECT"
