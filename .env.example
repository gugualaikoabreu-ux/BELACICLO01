# Supabase Auth: URL e chave publica (publishable/anon) podem estar no navegador.
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Canonical public callback used by signup, confirmation resend, and password recovery.
NEXT_PUBLIC_AUTH_CALLBACK_URL="https://belaciclo-loja.vercel.app/auth/callback"
# Opcional e somente no backend. Nunca usar em componentes do navegador.
SUPABASE_SECRET_KEY=""
# Compatibilidade com projetos que ainda usam a chave legada.
SUPABASE_SERVICE_ROLE_KEY=""

# PostgreSQL exclusivo do servidor. Nunca use NEXT_PUBLIC_ neste valor.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/postgres?schema=public"
# Opcional para rodar migrações por conexão direta, separada da conexão runtime.
DIRECT_DATABASE_URL=""

# Conta que recebe o papel OWNER depois de confirmar o e-mail.
STORE_ADMIN_EMAIL="gustavo.alaiko@icloud.com"

# BelaCiclo usa somente PIX manual; confirme o recebedor no banco antes de habilitar.
PIX_MODE="manual"
PIX_STATIC_KEY=""
PIX_MERCHANT_NAME=""
PIX_MERCHANT_CITY=""
PAYMENT_RESERVATION_MINUTES="20"

# Frete fixo definido pela BelaCiclo, em centavos. Sem valor, checkout e cotacao ficam fechados.
SHIPPING_FIXED_CENTS=""
RESERVATION_CRON_SECRET=""

# Correios. Teste em homologação antes de habilitar produção. Habilite PREÇOS (38202)
# e PRAZOS (38210) no contrato/cartão. Credenciais somente no ambiente do servidor.
CORREIOS_MODE="homologation"
CORREIOS_ID_CORREIOS=""
CORREIOS_API_ACCESS_CODE=""
CORREIOS_CONTRACT=""
CORREIOS_POSTING_CARD=""
CORREIOS_DR=""
CORREIOS_ORIGIN_CEP="81570001"
# Códigos candidatos padrão; a API retorna somente serviços habilitados/disponíveis na rota.
# Troque pelos códigos autorizados no contrato se os Correios fornecerem outros.
CORREIOS_SERVICE_CODES="03220:SEDEX,03298:PAC"

# Dados comerciais reais da loja (nao inventar ou deixar vendas publicas sem revisao).
NEXT_PUBLIC_STORE_EMAIL=""
STORE_LEGAL_NAME=""
STORE_CNPJ=""
STORE_ADDRESS=""

# E-mail transacional
RESEND_API_KEY=""
EMAIL_FROM=""
EMAIL_CRON_SECRET=""

# Armazenamento de imagens compativel com S3
MEDIA_BUCKET_URL=""
MEDIA_PUBLIC_BASE_URL=""
MEDIA_REGION="auto"
MEDIA_ACCESS_KEY=""
MEDIA_SECRET_KEY=""

# Site, indexacao e analytics
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
STORE_INDEXING_ENABLED="false"
NEXT_PUBLIC_GA4_ID=""
GOOGLE_ANALYTICS_API_SECRET=""
